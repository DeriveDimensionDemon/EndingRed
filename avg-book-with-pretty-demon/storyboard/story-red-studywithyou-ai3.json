              "type": "cg",
              "image": "ddd-avg-red-cg1_s.jpg"
            },
            {
              "type": "demon-emoji",
              "value": "😐"
            }
          ],
          "next": 2
        },
        {
          "player-move": "「是。請問壽星是誰？」",
          "score": 3,
          "events": [
            {
              "type": "cg",
              "image": "ddd-avg-red-cg1_s.jpg"
            },
            {
              "type": "demon-emoji",
              "value": "❓"
            }
          ],
          "next": 2
        },
        {
          "player-move": "「是。先說好，我們不提供抓捕壽星服務。」",
